# Menus: left stick moves the mouse, A clicks.
# Race: d-pad = arrow keys. Select+Start quits.
# Esc only on Select: under the Wine desktop, Esc during the intro quits the game.
back = esc
start = enter
a = mouse_left
b = enter
x = space
y = f1
l1 = mouse_slow
r1 = mouse_right

up = up
down = down
left = left
right = right

left_analog_up = mouse_movement_up
left_analog_down = mouse_movement_down
left_analog_left = mouse_movement_left
left_analog_right = mouse_movement_right
mouse_slow_scale = 50
